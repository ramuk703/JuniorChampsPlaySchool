NODE_ENV=development
PORT=5000
SHUTDOWN_TIMEOUT_MS=10000

MONGODB_URI=

JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_ISSUER=juniorchamps-api
JWT_AUDIENCE=juniorchamps-client

FRONTEND_URL=http://localhost:5173

# Email / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Junior Champ's Play School
SMTP_FROM_EMAIL=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=10000

REDIS_URL=redis://juniorchamps_app:CHANGE_ME@redis:6379

LOG_LEVEL=info


# Database Backup
MONGODB_DATABASE=test
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=7

# Authentication Protection
AUTH_FAILED_WINDOW_SECONDS=900
AUTH_FAILED_THRESHOLD=5
AUTH_PROTECTION_COOLDOWN_SECONDS=300

# Rate Limiting
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=100

RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10

RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_REGISTER_MAX=5

RATE_LIMIT_SENSITIVE_WINDOW_MS=900000
RATE_LIMIT_SENSITIVE_MAX=20

RATE_LIMIT_EXPORT_WINDOW_MS=900000
RATE_LIMIT_EXPORT_MAX=10
